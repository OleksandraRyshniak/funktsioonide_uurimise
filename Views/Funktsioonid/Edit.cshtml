@model FunktsiooniUurimine

@{
    ViewData["Title"] = "Muuda";
}

<h1 class="mb-4">Muuda funktsiooni</h1>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    <partial name="_Valjad" />

    <div class="d-flex gap-2 flex-wrap mt-3">

        <button type="submit"
                class="btn btn-primary">
            Salvesta
        </button>

        <button type="button"
                class="btn btn-secondary"
                onclick="joonistaGraafik(document.getElementById('Valem').value)">
            Eelvaade
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            Tühista
        </a>

    </div>

</form>

<partial name="_Graafik" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        joonistaGraafik(@Json.Serialize(Model.Valem));
    </script>
}