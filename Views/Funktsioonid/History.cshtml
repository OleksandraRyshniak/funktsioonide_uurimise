@model IEnumerable<FunktsiooniUurimine>

@{
    ViewData["Title"] = "Ajalugu";
}

<partial name="_ValemiKuva" />

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Funktsioonide ajalugu</h1>
            <p class="text-muted mb-0">
                Varem uuritud funktsioonid
            </p>
        </div>

        <a asp-controller="Funktsioonid"
           asp-action="Create"
           class="btn btn-primary">
            + Uus funktsioon
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h3>Ajaloos pole veel funktsioone</h3>

                <p class="text-muted">
                    Loo esimene funktsiooni uuring.
                </p>

                <a asp-controller="Funktsioonid"
                   asp-action="Create"
                   class="btn btn-primary">
                    Loo funktsioon
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title">
                                f(x) =
                                <span data-valem="@item.Valem">
                                    @item.Valem
                                </span>
                            </h4>

                            <p class="text-muted small">
                                @item.LuodudAeg.ToLocalTime()
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary">
                                Vaata
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Muuda
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Kustuta
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>