@model IEnumerable<FunktsiooniUurimine>

@{
    ViewData["Title"] = "Ajalugu";
}

<partial name="_ValemiKuva" />

<div class="ajalugu-pais">
    <div>
        <h1>Funktsioonide ajalugu</h1>
        <p class="text-muted mb-0">Varem uuritud funktsioonid</p>
    </div>

    <a asp-controller="Funktsioonid" asp-action="Create" class="btn btn-primary">
        + Uus funktsioon
    </a>
</div>

@if (!Model.Any())
{
    <div class="tuhi-ajalugu">
        <h3>Ajaloos pole veel funktsioone</h3>
        <p class="text-muted">Loo esimene funktsiooni uuring.</p>
        <a asp-controller="Funktsioonid" asp-action="Create" class="btn btn-primary">
            Loo funktsioon
        </a>
    </div>
}
else
{
    <ul class="ajalugu-list">
        @foreach (var item in Model)
        {
            <li class="ajalugu-rida">

                <a asp-action="Details" asp-route-id="@item.Id" class="ajalugu-valem">
                    <span class="ajalugu-fx">f(x) =</span>
                    <span data-valem="@item.Valem">@item.Valem</span>
                </a>

                <span class="ajalugu-aeg">
                    @item.LuodudAeg.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </span>

                <span class="ajalugu-tegevused">
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">Muuda</a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">Kustuta</a>
                </span>

            </li>
        }
    </ul>
}
