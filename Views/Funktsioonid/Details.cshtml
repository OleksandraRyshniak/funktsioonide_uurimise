@model FunktsiooniUurimine

@{
    ViewData["Title"] = "Funktsiooni uurimine";

    var lahendus = ViewBag.Lahendus as List<LahendusSamm>;
}

<partial name="_ValemiKuva" />


<!-- Funktsioon -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="text-muted mb-2">
            Funktsioon
        </div>

        <h2 class="mb-0">
            f(x) =
            <span data-valem="@Model.Valem">
                @Model.Valem
            </span>
        </h2>

    </div>

</div>


<!-- Vastused ja lahenduskäik -->
@if (lahendus != null && lahendus.Count > 0)
{
    <h3 class="mb-3">
        Vastused ja lahenduskäik
    </h3>

    @foreach (var samm in lahendus)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header bg-white">
                <h4 class="mb-0">
                    @samm.Pealkiri
                </h4>
            </div>

            <div class="card-body">

                @foreach (var rida in samm.Read)
                {
                    if (rida.StartsWith("Vastus:"))
                    {
                        <div class="vastus-kast">

                            <div class="vastus-pealkiri">
                                Vastus
                            </div>

                            <div class="vastus-tekst">
                                @rida.Substring(7).Trim()
                            </div>

                        </div>
                    }
                }


                <div class="lahenduskaik mt-3">

                    <div class="lahendus-pealkiri">
                        Kuidas vastus saadi?
                    </div>

                    @foreach (var rida in samm.Read)
                    {
                        if (!rida.StartsWith("Vastus:"))
                        {
                            <div class="lahendus-rida">
                                @rida
                            </div>
                        }
                    }

                </div>

            </div>

        </div>
    }
}
else
{
    <div class="alert alert-warning">
        Selle funktsiooni tulemusi ei ole veel arvutatud.
    </div>
}


<!-- Graafik -->

<div class="mt-4">

    <h3 class="mb-3">
        Graafik
    </h3>

    <partial name="_Graafik" />

</div>


<!-- Kuupäev -->

<p class="text-muted small mt-4">
    Loodud:
    @Model.LuodudAeg.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
</p>


<!-- Nupud -->

<div class="d-flex gap-2 flex-wrap mt-3 mb-4">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Muuda
    </a>

    <a asp-action="History"
       class="btn btn-secondary">
        Tagasi ajalukku
    </a>

</div>


<style>

    .vastus-kast {
        padding: 16px 18px;
        background: #eef7ff;
        border: 1px solid #cfe2ff;
        border-radius: 12px;
        margin-bottom: 16px;
    }

    .vastus-pealkiri {
        color: #0d6efd;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .vastus-tekst {
        font-size: 18px;
        font-weight: 600;
        white-space: pre-line;
    }

    .lahenduskaik {
        padding-top: 4px;
    }

    .lahendus-pealkiri {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .lahendus-rida {
        padding: 9px 0;
        border-bottom: 1px solid #eeeeee;
        line-height: 1.6;
    }

        .lahendus-rida:last-child {
            border-bottom: 0;
        }

</style>


@section Scripts
{
    <script>
        joonistaGraafik(@Json.Serialize(Model.Valem));
    </script>
}