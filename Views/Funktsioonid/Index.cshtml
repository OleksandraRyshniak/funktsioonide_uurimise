@{
    ViewData["Title"] = "Avaleht";
}

<div class="home-page">

    <section class="hero-section">

        <div class="hero-content">

            <div class="hero-badge">
                Matemaatiliste funktsioonide uurimine
            </div>

            <h1>
                Uuri funktsioone
                <span>lihtsamalt</span>
            </h1>

            <p class="hero-text">
                Sisesta matemaatiline funktsioon ja vali,
                milliseid omadusi soovid uurida.
                Programm arvutab tulemused ja näitab lahenduskäiku.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Funktsioonid"
                   asp-action="Create"
                   class="btn btn-primary btn-lg">
                    + Uus funktsioon
                </a>

                <a asp-controller="Funktsioonid"
                   asp-action="History"
                   class="btn btn-outline-primary btn-lg">
                    Ajalugu
                </a>

            </div>

        </div>

    </section>


    <section class="features-section">

        <div class="feature-card">

            <div class="feature-icon">
                f(x)
            </div>

            <h3>Funktsiooni sisestamine</h3>

            <p>
                Sisesta funktsioon lihtsalt ja kasuta
                matemaatilist klaviatuuri.
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                ✓
            </div>

            <h3>Vali uuringud</h3>

            <p>
                Vali ainult need omadused, mida soovid
                oma funktsiooni puhul uurida.
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                ∫
            </div>

            <h3>Lahenduskäik</h3>

            <p>
                Vaata lisaks tulemusele ka lühikest
                selgitust selle kohta, kuidas vastus leiti.
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                ↗
            </div>

            <h3>Graafik</h3>

            <p>
                Vaata funktsiooni graafikut ja selle
                olulisi punkte.
            </p>

        </div>

    </section>

</div>