@{
    ViewData["Title"] = "Avaleht";
}

<div class="home-page">

    <section class="hero-section">

        <div class="hero-content">

            <div class="hero-badge">
                Matemaatiliste funktsioonide uurimine
            </div>

            <h1>
                Uuri funktsioone
                <span>lihtsamalt</span>
            </h1>

            <p class="hero-text">
                Sisesta matemaatiline funktsioon ja vali,
                milliseid omadusi soovid uurida.
                Programm arvutab tulemused ja näitab lahenduskäiku.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Funktsioonid"
                   asp-action="Create"
                   class="btn btn-primary btn-lg">
                    + Uus funktsioon
                </a>

                <a asp-controller="Funktsioonid"
                   asp-action="History"
                   class="btn btn-outline-primary btn-lg">
                    Ajalugu
                </a>

                <a asp-controller="Funktsioonid"
                   asp-action="Teatmik"
                   class="btn btn-outline-primary btn-lg">
                    Juhend
                </a>

            </div>

        </div>

    </section>

</div>