@model FunktsiooniUurimine
@{
    ViewData["Title"] = "Uus funktsioon";
}

<h1>Uus funktsioon</h1>

<form asp-action="Create" method="post">
    <partial name="_Valjad" />
    <button type="submit" class="btn btn-success">Salvesta</button>
    <button type="button" class="btn btn-secondary"
            onclick="joonistaGraafik(document.getElementById('Valem').value)">
        Eelvaade
    </button>
    <a asp-action="Index" class="btn btn-link">Tühista</a>
</form>

<partial name="_Graafik" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}